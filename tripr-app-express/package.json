{
  "name": "tripr-app-express",
  "version": "1.0.0",
  "description": "Tripr Trip Planning Application - Express.js Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "prestart": "npm --prefix client run build",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env PORT=3001 nodemon src/index.js",
    "dev:client": "npm --prefix client run serve",
    "test": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "express",
    "mongodb",
    "socket.io",
    "auth0"
  ],
  "author": "Codeworks",
  "license": "ISC",
  "dependencies": {
    "@bcwdev/auth0provider": "^1.0.7",
    "body-parser": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "helmet": "^4.6.0",
    "mongoose": "^6.0.6",
    "socket.io": "^4.1.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^7.26.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-plugin-import": "^2.23.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.1.0",
    "jest": "^27.5.1",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": "^14.0.0"
  }
}
